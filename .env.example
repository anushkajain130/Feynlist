# =============================================================================
# Feynlist Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# Models (free tier: Flash / Flash-Lite only; Pro has no free quota).
# Personas pick "standard" or "light" in agents/personas/*.yaml.
# Set both to whichever model has the higher free daily allowance in your AI Studio rate-limit page.
GEMINI_MODEL_STANDARD=gemini-2.5-flash
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
# Thinking budget for 2.5 Flash (0 = off; thinking tokens count against the short reply limit).
GEMINI_THINKING_BUDGET=0

# --- Database ---
# SQLite database file path (relative to project root)
DATABASE_PATH=feynlist.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/feynlist.log

# --- Agent Settings ---
# How often (seconds) the orchestrator runs its scheduled check cycle
AGENT_SCHEDULE_INTERVAL_SECONDS=1200

# Minimum seconds between any two agent responses (global cooldown)
GLOBAL_AGENT_COOLDOWN_SECONDS=300

# --- Scheduling ---
# Default time zone (IANA name) for scheduled jobs and requests without a browser time zone.
# Leave empty to use the server's local time. Browser requests send their own zone.
APP_TIMEZONE=

# --- Analytics ---
# Consistency streak: a day counts if the user taps "I kept my commitment today"
# or completes at least this share of their planned tasks (0.0-1.0).
STREAK_MIN_COMPLETION=0.5

# --- Public demo (evaluator) mode ---
# true = each browser session gets its own temporary database with sample data.
DEMO_MODE=false
# Where session databases live. Temporary storage is fine (sessions are throwaway).
DEMO_DATA_DIR=/tmp/feynlist-demo
# Oldest sessions beyond this are deleted.
DEMO_MAX_SESSIONS=200
# Frontend URL(s) allowed to call this API, comma-separated (e.g. https://your-app.vercel.app). "*" = any.
ALLOWED_ORIGINS=*

# --- Free-tier AI budget ---
# Live AI replies per evaluator session (chat + demo controls together). After that: labelled sample replies.
LIVE_REPLIES_PER_SESSION=2
# Live model requests per day across everyone (resets at midnight Pacific). Set it BELOW your
# AI Studio daily request limit, leaving room for your own testing. 0 = no cap.
LIVE_AI_DAILY_CAP=20
# Live model requests per rolling minute; extra requests get a sample reply and "try again in a moment".
LIVE_AI_PER_MINUTE=8
# Where the budget counters are stored (kept separate from session data, so "Reset demo" can't refill them).
AI_BUDGET_PATH=/tmp/feynlist-demo/ai_budget.db
# true = scheduled jobs and automatic nudges call the model (local/real use). Keep false for the public demo.
ENABLE_PROACTIVE_LLM=false
